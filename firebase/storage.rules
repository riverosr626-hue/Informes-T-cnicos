rules_version = '2';

// Reglas de Storage (fotos) — pegar completo en Firebase > Storage > Reglas > Publicar
service firebase.storage {
  match /b/{bucket}/o {

    // Cada técnico sube fotos solo a su carpeta: fotos/<su-id>/...
    // Las ve el mismo técnico o el administrador.
    match /fotos/{uid}/{archivo} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow read: if request.auth != null
        && (request.auth.uid == uid
            || firestore.get(/databases/(default)/documents/perfiles/$(request.auth.uid)).data.rol == 'admin');
    }
  }
}
